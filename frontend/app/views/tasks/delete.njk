{% extends "layouts/main.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk"    import govukButton %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back to task", href: "/tasks/" + task.id }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-l">Task {{ task.id }}</span>
      <h1 class="govuk-heading-l">Are you sure you want to delete this task?</h1>
      <p class="govuk-body">The task will be permanently removed. You cannot undo this action.</p>

      <form method="post" action="/tasks/{{ task.id }}/delete">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="govuk-button-group">
          {{ govukButton({ text: "Yes, delete this task", classes: "govuk-button--warning" }) }}
          <a class="govuk-link" href="/tasks/{{ task.id }}">No, keep this task</a>
        </div>
      </form>

    </div>
  </div>
{% endblock %}
