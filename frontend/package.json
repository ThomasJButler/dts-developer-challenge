{
  "name": "manage-your-tasks",
  "version": "0.1.0",
  "private": true,
  "description": "HMCTS caseworker task-management frontend.",
  "main": "bin/www",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/www",
    "dev": "nodemon bin/www",
    "test": "mocha 'test/**/*.js'",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "e2e:screenshots": "UPDATE_SCREENSHOTS=1 playwright test screenshots.spec --project=desktop --project=mobile"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "govuk-frontend": "^5.7.1",
    "luxon": "^3.7.2",
    "nunjucks": "^3.2.4",
    "undici": "^6.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.60.0",
    "chai": "^4.4.1",
    "eslint": "^9.10.0",
    "globals": "^15.9.0",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
