# Copy to .env and adjust as needed. .env is gitignored.

# Postgres (consumed by docker-compose and by the backend's DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks

# Backend (FastAPI)
# Use the "db" host name inside the compose network; use "localhost" when
# running uvicorn locally against the compose Postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tasks

# Test suite. Optional — if unset, Settings derives this from
# DATABASE_URL by swapping the database name to `tasks_test`. The test DB
# is created automatically by the pytest fixture on first run.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tasks_test

# Frontend (Express)
# Where the frontend reaches the API. Use http://backend:8000 inside compose,
# http://localhost:8000 when running both processes locally.
API_BASE_URL=http://localhost:8000
PORT=3000

# Signs the express-session cookie. The frontend throws on startup in
# production if this is unset; in development it falls back to a constant
# dev secret. Compose sets a nominal value of its own.
SESSION_SECRET=dev-session-secret-not-for-production
